{
  "name": "ai-dev",
  "version": "1.2.2",
  "description": "CLI determinista de Software AI Development Methodology",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/copy-assets.mjs && tsup",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:gen": "tsx scripts/gen-docs.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "12.1.0",
    "gray-matter": "4.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "bin": {
    "ai-dev": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets"
  ],
